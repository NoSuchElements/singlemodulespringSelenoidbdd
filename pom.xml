		    <version>3.0.7</version>
		</dependency>

		<!-- Source:
		https://mvnrepository.com/artifact/com.aventstack/extentreports -->
		<dependency>
			<groupId>com.aventstack</groupId>
			<artifactId>extentreports</artifactId>
			<version>5.0.9</version>
			<scope>compile</scope>
		</dependency>
		<!-- qTest SDK -->
		<dependency>
			<groupId>com.qasymphony.qtest</groupId>
			<artifactId>qtest-sdk-java</artifactId>
			<version>1.4.10</version> <!-- or the latest available -->
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-handler</artifactId>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp</artifactId>
			<version>4.12.0</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.15.2</version>
		</dependency>
		<dependency>
			<groupId>javax.annotation</groupId>
			<artifactId>javax.annotation-api</artifactId>
			<version>1.3.2</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		 
	</dependencies>

	<build>
        <plugins>
            <!-- 1. PROPERTIES PLUGIN - LOADS qtest.properties FIRST -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.2.1</version>
                <executions>
                    <execution>
                        <id>read-qtest-properties</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${project.basedir}/src/main/resources/qtest.properties</file>
                            </files>
                            <quiet>false</quiet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
 
            <!-- 2. COMPILER -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler.version}</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
 
            <!-- 3. SINGLE FAILSAFE - Handles ALL tests (TestNG + Cucumber) -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <dependencies>
                <dependency>
                    <groupId>org.apache.maven.surefire</groupId>
                    <artifactId>surefire-testng</artifactId>
                    <version>3.5.2</version>
                </dependency>
            </dependencies>
            <executions>
                <execution>
                    <id>integration-test</id>
                    <phase>integration-test</phase>
                    <goals><goal>integration-test</goal></goals>
                    <configuration>
                        <suiteXmlFiles>
                            <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                        </suiteXmlFiles>
						 <properties>
						 	<property>
								<name>dataproviderthreadcount</name>
								<value>2</value>
							</property>
						</properties>
                        <useFile>false</useFile>
                    </configuration>
                </execution>
                <execution>
                    <id>verify</id>
                    <phase>verify</phase>
                    <goals><goal>verify</goal></goals>
                </execution>
            </executions>
        </plugin>
        
		<!-- Split PDF Reporter Plugin (replaces cucumber-pdf-qtest-plugin) -->
			<plugin>
				<groupId>com.qtest</groupId>
				<artifactId>split-pdf-reporter-plugin</artifactId>
				<version>${split.pdf.reporter.version}</version>
				<executions>
					<execution>
						<id>generate-per-feature-pdfs</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>generate-pdfs</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- Single JSON mode (default produced by Cucumber runner) -->
					<cucumberJson>${project.build.directory}/cucumber-reports/Cucumber.json</cucumberJson>
 
					<!-- Where PDFs will be written -->
					<reportOutputDir>${project.build.directory}/pdf-reports</reportOutputDir>
 
					<!-- Optional: use glob instead of single file, if needed in
					future -->
					<!--
					<cucumberJsonPattern>target/**/cucumber*.json</cucumberJsonPattern> -->
				</configuration>
			</plugin>
 
 
            <!-- 4. QTEST CUCUMBER PLUGIN -->
            <plugin>
                <groupId>com.nosuchelements</groupId>
                <artifactId>qtest-cucumber-plugin</artifactId>
                <version>1.2.0</version>
                <executions>
                    <execution>
                        <id>update-qtest</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>update-qtest</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- These will be resolved from qtest.properties file -->
                    <qtestUrl>${qtest.url}</qtestUrl>
                    <qtestProjectId>${qtest.project.id}</qtestProjectId>
                    <qtestReleaseCycleId>${qtest.release.cycle.id}</qtestReleaseCycleId>
                    <attachScreenshots>${qtest.attach.screenshots}</attachScreenshots>
                    <connectionTimeout>${qtest.connection.timeout}</connectionTimeout>
                    <retryAttempts>${qtest.retry.attempts}</retryAttempts>
                    <enabled>${qtest.enabled}</enabled>
                    <failOnError>${qtest.fail.on.error}</failOnError>
 
                    <!-- Properties file location (optional fallback) -->
                    <propertiesFile>src/main/resources/qtest.properties</propertiesFile>
 
                    <!-- Cucumber JSON report location -->
                    <cucumberJsonReportDirectory>${project.build.directory}/cucumber-reports</cucumberJsonReportDirectory>
                </configuration>
            </plugin>
 
        </plugins>
    </build></project>
